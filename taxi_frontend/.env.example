# Frontend (Vite + Svelte) environment example
# Vite exposes env variables prefixed with VITE_ at build time.

# Base URL for REST API. If not set, the app will default to current window.origin with port 3001.
# Example for local dev:
VITE_API_BASE=http://localhost:3001

# Base URL for WebSocket (Socket.IO) endpoint. If not set, the app will construct ws(s)://<host>:3001.
# Provide the full origin (scheme + host + optional port), the app will append the Socket.IO path.
# Example for local dev:
VITE_WS_BASE=ws://localhost:3001
